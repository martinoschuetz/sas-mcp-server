   <Code><![CDATA[/* PREPROCESS to prepare for analysis work                         */
%afi_caf_preprocess(?g_cas, ?analysisID);


CAS qasout SESSOPTS=(CASLIB=QASANLOUT) ;
libname qasout CAS sessref=qasout;
caslib _all_ assign;


option mprint; 

/* Create Filters for Data */

%put &=G_p_selectFilter.;
%global /* G_STABLESTART G_STABLEEND*/ G_TIME_FILTER fltrd_varlist fltrd_varlist2 mdlvars;
%macro generate_time_filter;

  %local i G_STABLE_PART G_STABLESTART G_STABLEEND;
  %let i = 1;
  %let G_TIME_FILTER =;


%if (%length(&G_p_selectFilter.) >0) %then %do; 

    %let G_p_selectFilter = %sysfunc(strip(&G_p_selectFilter.));
    %let G_STABLE_PART = %scan(%nrbquote(&G_p_selectFilter.), &i., ','); 

    %do %until (%length(&G_STABLE_PART.) = 0); 
        %let G_STABLESTART = %scan(%nrbquote(&G_STABLE_PART.), 1, '-');
        %let G_STABLEEND = %scan(%nrbquote(&G_STABLE_PART.), 2, '-');

        %if &i. eq 1 %then %do;
        %let G_TIME_FILTER = (datetime le "&G_STABLESTART."dt or datetime ge "&G_STABLEEND."dt);
        %end;
        %else %do;
        %let G_TIME_FILTER = &G_TIME_FILTER. and (datetime le "&G_STABLESTART."dt or datetime ge "&G_STABLEEND."dt);
        %end;

        %put &=i. &=G_STABLE_PART. &=G_STABLESTART. &=G_STABLEEND.;
    
        %let i = %eval(&i. + 1);
        %let G_STABLE_PART = %scan(%nrbquote(&G_p_selectFilter.), &i., ','); 
    %end;

  %let G_TIME_FILTER=(&G_TIME_FILTER.);
%end;

%else %do;
%put Note: No Date Filter Selected;
%end;

  %let fltrd_varlist = %sysfunc(tranwrd(%quote(&g_p_input.), %str(,), %str( )));
  %let fltrd_varlist2 = %sysfunc(tranwrd(%quote(&g_p_input.), %str(,), %str(",")));

%mend generate_time_filter;

%generate_time_filter;
%put &=G_TIME_FILTER.;

/* Train Model */

%put &=g_p_inputvar; 

data qasout.modeldata; 
  set qasout.&g_analysis_type._analysis_data_&g_short_id.;
  where  &G_TIME_FILTER.; 
run;

%let varlist_new = %sysfunc(tranwrd(%quote(&g_p_inputvar), %str(,), %str( )));

proc partition data=qasout.modeldata samppct=70 seed=123 partind;
   output out=qasout.modeldata  ;
/*   display 'SRSFreq';*/
run;

ods output VariableImportance=VariableImportance;

proc forest data = qasout.modeldata;
	id assetID; 
  	input &varlist_new. /level=interval; 
	target  &g_p_target. /level=interval;
	partition rolevar=_PartIND_(train='0' validate='1');
	savestate rstore=qasout.saveFOREST; 
	output out=qasout.outForest copyvars=(_ALL_); 
run;  

proc assess data=qasout.outForest fitstatout=qasout.fst_Frst;
   var P_&g_p_target. ;
   target &g_p_target.  /level=interval ;
   fitstat pvar=P_&g_p_target.   ;
   by _PartInd_;
run;


data VarImp; 
  set VariableImportance; 
run; 


proc astore;
   download rstore = qasout.saveFOREST
            store = "/export/viya/homes/priya.sharma@sas.com/data/solarFarm/astore/saveFOREST.sasast";
run;

/* To finish the analysis specific code, setup the info needed for */
/* the postprocess.                                                */

/* Provide any output tables to be persisted and used later.       */
/* Postprocess will promote and save the output tables in the      */
/* QASANLOUT global caslib using a standard naming convention of   */
/* <analysis_type>_tablename_<shortid>                             */
/* For example: CARS_filtered_ABC123                               */
/*              CARS_complete_ABC123                               */

%let g_num_output_tables = 4;

%let g_output_table_1 = qasout.fst_Frst;
