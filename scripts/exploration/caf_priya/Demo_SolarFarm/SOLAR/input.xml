   <Code><![CDATA[/* PREPROCESS to prepare for analysis work                         */
%afi_caf_preprocess(?g_cas, ?analysisID);


CAS qasout SESSOPTS=(CASLIB=QASANLOUT) ;
libname qasout CAS sessref=qasout;
caslib _all_ assign;


option mprint; 
%macro ingest_data;

  

    data work.analysis_data; 
		format datetime datetime21.; 
        set &g_p_caslib..&g_p_tablenm.; 
		datetime = dhms(mdy(1,1,1970),0,0, msr_timestamp/1000000);
		drop opcode key1 key2 flags msr_timestamp;
		Where assetID="Inverter_A";
    run; 
   

    /* Prep Metadata for dropdown */

/* Asset List */
proc sql; 
	create table assetList as 
		select distinct(assetID) as assetID
from work.analysis_data; 
quit;


/* Target & Input Variables */

proc contents data=work.analysis_data out=work.contents noprint ; 
run;

proc sql noprint; 
	create table work.varList as 
		select distinct(name) as VAR_COLUMN_NAME
		from work.contents 
		where name not in ( "assetID", "assetType", "datetime"); 
quit;

data _null_;
	set assetList end=end;
	count+1;
 	call symputx("assetID"||left(count),assetID);
	if end then call symputx('assetCnt',count);
run; 

%put &&assetID1; 
%do i=1 %to &assetCnt.;

data assetMetadata_&i.;
format  ASSET_ID ASSET_ID_DESC TAG_ID TAG_ID_DESC $32.;
	set work.varList ; 
	ASSET_ID="&&assetID&i."; 
	ASSET_ID_DESC="&&assetID&i."; 
	TAG_ID=VAR_COLUMN_NAME; 
	TAG_ID_DESC="&&assetID&i."||"."||VAR_COLUMN_NAME; 
keep ASSET_ID ASSET_ID_DESC TAG_ID TAG_ID_DESC; 

run; 

%end;

data assetTagList; 
	set %do i=1 %to &assetCnt.;
		assetMetadata_&i.
		%end;;
run; 

%mend;

%ingest_data;

/* To finish the analysis specific code, setup the info needed for */
/* the postprocess.                                                */

/* Provide any output tables to be persisted and used later.       */
/* Postprocess will promote and save the output tables in the      */
/* QASANLOUT global caslib using a standard naming convention of   */
/* <analysis_type>_tablename_<shortid>                             */
/* For example: CARS_filtered_ABC123                               */
/*              CARS_complete_ABC123                               */
%let g_num_output_tables = 4;
%let g_output_table_1 = work.analysis_data;
%let g_output_table_2 = work.assetList;
%let g_output_table_3 = work.varList;
%let g_output_table_4 = work.assetTagList;



/* Provide any output variable to be used later.                   */
/* Postprocess will save these variables into metadata so they can */
/* be used in the VA output or in later analysis steps             */
/* For example: filtered_count = 20                                */
%let g_num_output_vars = 1;
%let g_output_var_1 = &g_p_tablenm.;

/* *************************************************************** */
/* END ANALYSIS SPECIFIC PROGRAMMING                               */
/* *************************************************************** */



/* PREPROCESS to save analysis work                                */
%afi_caf_postprocess;]]></Code>
