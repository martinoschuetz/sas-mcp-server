   <Code><![CDATA[
/* PREPROCESS to prepare for analysis work                         */
%afi_caf_preprocess(?g_cas, ?analysisID);



/* Libname to access Launch output                                 */
CAS qasout SESSOPTS=(CASLIB=QASANLOUT) ;
libname qasout CAS sessref=qasout;

/* Custom Code for Spectrogram                                     */


%let workpath=%sysfunc(pathname(WORK));

/* FIRST - write the output of the proc to a temp location using ODS */

ODS graphics on / reset imagename="spectrogram" imagefmt=png;

ods listing gpath = "&workpath";

ods graphics /NXYBINSMAX= 2000000 MAXOBS=3000000;

PROC IMPORT DATAFILE="/export/sas-viya/homes/prshar/Common_Data/VibrationAnalysis/data/combined_data.csv"
    OUT=work.combined_data
    DBMS=CSV
    REPLACE;
    GETNAMES=YES;
RUN;

proc iml;
   use combined_data;
   read all var {a1} into x where (status="&g_p_Status." & load=&g_p_load.);
   close combined_data;

   Fs  = 30;         /* sampling frequency */
   win_len =  256;  
   dt  = 1/Fs;
   n = nrow(x);
   t = do(1, n*dt, dt); /* timestamps of the data vector */

   overlap = round((win_len+1)/2);
   fftlen = 2##(ceil(log2(win_len)));
   window = tfwindow(win_len, "Hanning");


  /* 2. Use SPECTROGRAM subroutine*/
   call spectrogram(x, win_len)
        fftlen=fftlen
        sampRate=Fs
        panel=0
        title="STFT Power Using SPECTROGRAM"
        colorramp="BlueGreenRed"
        scale='DB';
  
   /* 1. Use TFSTFT and SPECTROVIZ subroutines*/
   y = tfstft(x, window, overlap, fftlen);

   freq = y[, 1]*Fs;
   time = y[, 2]/Fs;
   dbPower = 10*log10(abs(y[, 3])+1e-12);

   labls = {"Time","Frequency","Power (dB)","Avg dBPower"};
   call spectroviz(t, x, dbPower, time, freq)
        panel=0
        labels=labls
        title="STFT Power Using TFSTFT and SPECTROVIZ"
        colorramp="BlueGreenRed";

   

   /* Thresholding on the time-frequency heat map */
   thresholdDB = 35;
   T = dbPower > thresholdDB; /* Binarize the power values */
   dbPower_new = dbPower # T;
   labls = {"Time","Frequency","Power (dB)"};
   call spectroviz(t, x, dbPower_new, time, freq)
        panel=0
        labels=labls
        title="STFT Power after Thresholding"
        colorramp="BlueGreenRed";

quit;

/* SECOND - copy the ODS generated png into SAS Content */
FILENAME tmpfile "&workpath/spectrogram.png" RECFM=F LRECL=1;
FILENAME scfile FILESRVC folderpath="/Public/VibrationAnalysis/Output" filename="spectrogram.png" RECFM=F LRECL=1;

data _null_;
   rc=fcopy('tmpfile', 'scfile');
run;]]></Code>
